{
  "name": "@openpims/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./schema/index.ts",
    "./client": "./client.ts",
    "./connection-policy": "./connection-policy.ts",
    "./deployment-target": "./deployment-target.ts",
    "./migration-conformance": "./migration-conformance.ts",
    "./schema-drift": "./schema-drift.ts",
    "./rls-preflight": "./rls-preflight.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx seed.ts",
    "db:reset": "tsx reset.ts",
    "db:rls": "tsx apply-rls.ts",
    "db:rls:preflight": "tsx rls-preflight.ts",
    "db:rls:preflight:test": "tsx test-rls-preflight.ts",
    "db:rls:test": "tsx test-rls.ts",
    "db:privileged-action-proofs:test": "tsx test-privileged-action-proofs.ts",
    "db:webauthn:test": "tsx test-webauthn.ts",
    "db:auth-recovery:test": "tsx test-auth-recovery.ts",
    "db:finance-adoption:test": "tsx test-finance-adoption.ts",
    "db:treatment-plan-evidence:test": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f test-treatment-plan-evidence.sql",
    "db:treatment-plan-concurrency:test": "tsx test-treatment-plan-concurrency.ts",
    "db:sms-provider-resolutions:test": "tsx test-sms-provider-event-resolutions.ts",
    "db:migration-runs:test": "tsx test-migration-runs.ts",
    "db:lifecycle-email-outbox:test": "tsx test-lifecycle-email-outbox.ts",
    "db:subscription-checkout:test": "tsx test-subscription-checkout-attempts.ts",
    "db:release-line:test": "tsx test-release-line-reconciliation.ts",
    "db:subscription-cadence:test": "tsx test-subscription-cadence-operations.ts",
    "db:controlled-substance-ledger:test": "tsx test-controlled-substance-ledger.ts",
    "db:controlled-substance-ledger:audit": "tsx audit-controlled-substance-ledger.ts",
    "db:prescription-integrity:audit": "tsx audit-prescription-integrity.ts",
    "db:prescription-integrity:test": "tsx test-prescription-integrity.ts",
    "db:lab-result-integrity:audit": "tsx audit-lab-result-integrity.ts",
    "db:lab-result-integrity:test": "tsx test-lab-result-integrity.ts",
    "db:migrations:check": "pnpm --filter @openpims/web exec vitest run lib/__tests__/migration-journal-integrity.test.ts lib/__tests__/db-migrations.test.ts",
    "db:migrations:conformance": "tsx migration-conformance.ts",
    "db:target:check": "tsx deployment-target.ts",
    "db:drift": "tsx check-drift.ts",
    "db:baseline": "tsx baseline.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@openpims/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0"
  }
}
