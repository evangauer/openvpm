{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/usage-reconcile",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/billing-lifecycle",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/wellness-billing",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/rate-limit-cleanup",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/auth-cleanup",
      "schedule": "45 4 * * *"
    }
  ]
}
